DirectoryIndex index.php
RewriteEngine On

# PHP include soubory nejsou samostatné stránky. Server-side require zůstává funkční.
RewriteRule ^includes(?:/|$) - [F,L]

# Kanonizace domény: vynutit HTTPS a non-www verzi na produkci.
# Lokální vývoj (localhost/127.0.0.1) je z přesměrování vyňat, aby XAMPP fungoval i bez HTTPS.
RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:[0-9]+)?$ [NC]
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.trimistri\.cz$ [NC]
RewriteRule ^ https://trimistri.cz%{REQUEST_URI} [R=301,L]

# Dřívější čištění střech nahrazuje nabízený nátěr. Query string se zachová.
RewriteRule ^cisteni-strech-okapu(?:\.php)?/?$ /natery-strech [R=301,L]

# --- Hezké URL bez přípony .php ---

# 1) Homepage: /index.php -> / (301, ať se to nezaindexuje na dvou adresách)
#    Query string (např. ?form=ok) se zachová automaticky.
RewriteCond %{THE_REQUEST} /index\.php[\s?] [NC]
RewriteRule ^index\.php$ / [R=301,L]

# 2) Staré odkazy na *.php (už zaindexované) -> 301 na verzi bez přípony
#    Query string se zachová automaticky (nepřipisujeme vlastní "?").
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$
RewriteCond %{THE_REQUEST} \s/([^.\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# 3) Služby s koncovým lomítkem -> stejná kanonická URL bez lomítka.
#    Fyzické adresáře (např. assets/) a query string se zachovají.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} ^(.+?)/?$
RewriteCond %1.php -f
RewriteCond %{REQUEST_URI} ^(.+)/$
RewriteRule ^(.+)/$ %1 [R=301,L]

# 4) Interně dopsat příponu .php, pokud takový soubor existuje (uživatel/Google vidí URL bez .php)
#    Používáme REQUEST_FILENAME (ne DOCUMENT_ROOT), aby to fungovalo i když web běží v podadresáři.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L]

ErrorDocument 404 /404.php

# Certifikáty (PDF) nesmí do Google indexu - noindex hlavička, soubor se ale
# dál smí crawlovat a normálně stahovat/prohlížet návštěvníky.
<IfModule mod_headers.c>
  <FilesMatch "\.pdf$">
    Header set X-Robots-Tag "noindex, nofollow"
  </FilesMatch>
</IfModule>

# --- Komprese textových odpovědí (HTML/CSS/JS/JSON-LD) ---
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# --- Cache statických souborů ---
# CSS/JS nemají cache-busting verzování v názvu souboru, proto krátká cache (1 den),
# ať se úprava stylu/scriptu u vracejících se návštěvníků neprojeví se zpožděním týdnů.
# Fotky a fonty se prakticky nemění, proto delší cache (30 dní).
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/x-icon "access plus 30 days"
  ExpiresByType font/woff2 "access plus 30 days"
</IfModule>

# --- Základní bezpečnostní hlavičky (nemají vliv na indexaci, jen hygiena) ---
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
</IfModule>

# Fingerprinted performance assets: safe to cache for a year, new content = new URL.
<IfModule mod_mime.c>
  AddType image/avif .avif
  AddType font/woff2 .woff2
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "^(?:site(?:-service|-hosting|-home|-hosting-home)?\.[a-f0-9]{12}\.css|inter-[0-9]{3}\.[a-f0-9]{12}\.woff2|(?:homepage-hero(?:-mobile)?|process-kitchen)-[0-9]+\.[a-f0-9]{12}\.(?:avif|webp))$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
